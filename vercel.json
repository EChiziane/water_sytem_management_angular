{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/water-system-management-angular/browser",
  "functions": {"api/index.js": {"maxDuration": 30, "includeFiles": "server/**"}},
  "rewrites": [
    {"source": "/api/:path*", "destination": "/api/index?path=:path*"},
    {"source": "/((?!api/|assets/|data/).*)", "destination": "/index.html"}
  ],
  "headers": [
    {"source": "/api/:path*", "headers": [{"key": "Cache-Control", "value": "no-store"}]},
    {"source": "/(.*)", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "Referrer-Policy", "value": "same-origin"}]}
  ]
}
