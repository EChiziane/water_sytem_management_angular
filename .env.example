# Only server functions/tools read these values. Never put them in Angular environments.
BLOB_READ_WRITE_TOKEN=
WSM_DATA_NAMESPACE=preview
WSM_SESSION_SECRET=
# Optional: fixed Spring endpoint, never supplied by the browser.
SPRING_BACKUP_URL=
SPRING_BACKUP_TOKEN=
# Used ONLY by the explicit initialization tool; no default production credentials.
WSM_INITIAL_PASSWORDS_JSON=
# Optional one-time initial admin/recovery. Enable only for the initial owner login.
# This allows admin / 123456 once per data state; disable after setup.
WSM_ENABLE_INITIAL_ADMIN=false
